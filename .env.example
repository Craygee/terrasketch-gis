# Public browser credentials. These are safe to expose only because every data table has RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional. Displayed as the project's inbound email/BCC address only after the
# provider, DNS, database migration, signed webhook, and function are live.
# Recommended production value: inbound.landdraft.net
VITE_INBOUND_EMAIL_DOMAIN=

# Optional server-only fallback. The free Open-Meteo endpoint is evaluation/non-commercial and is
# disabled by default; production commercial use needs a suitable agreement or self-hosted data.
WEATHER_ENABLE_OPEN_METEO_EVALUATION=false

# Server-only. Required by the Cloudflare weather proxy for per-user Xweather
# connections. Use the same strong value across deployments that share the same
# Supabase database so encrypted user connections remain portable. Never prefix
# this with VITE_ or expose it to browser code.
XWEATHER_CREDENTIAL_ENCRYPTION_KEY=
